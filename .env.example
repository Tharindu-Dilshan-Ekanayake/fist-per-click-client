# Copy to `.env` (or `.env.local`) for local development. Nothing secret goes here:
# everything VITE_* is baked into the public JavaScript bundle.

# >>> FILL ME IN <<<
# The game slug from your Bloxity developer dashboard. Needed for logins.
VITE_GAME_SLUG=1-fist-per-click

# Bloxity endpoints. Leave these as-is unless you are running the portal locally.
# They MUST be set: without them the SDK repoints itself at localhost when it
# detects a dev server, and the login popup can never return a token.
VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io

# --- Where the game server is -----------------------------------------------------
# On Bloxity hosting none of this is needed: a page on <id>.play.bloxity.io works out
# its own back end and matchmaker from its address (see src/net/hosting.js).
#
# Local development: point everything at the server running on your machine. With
# this set, a localhost page connects straight to it instead of the matchmaker.
VITE_SERVER_URL=http://localhost:3000

# Hosted anywhere else (your own domain, Netlify): the hosting id from My Games, and
# which channel's back end to use. The socket then goes through the matchmaker and
# saves go to https://<id>[.dev].host.bloxity.io.
# VITE_HOSTING_ID=1-fist-per-click
# VITE_CHANNEL=prod

# Override the HTTP back end outright (rarely needed).
# VITE_BACKEND_URL=https://1-fist-per-click.dev.host.bloxity.io
